# CX Resolution Agent — configuration
#
# A real model is the lead profile. Set ONE provider below and the
# agent drafts its replies, reads free-text intent and explains
# charges with it; with nothing set the agent runs on the labelled
# offline fallback (deterministic drafting from structured findings —
# fine for the bundled scenarios, not a substitute for a model on
# real customer language). Every deterministic rule — routing,
# identity, escalation, money math, action gates — is code either way.

# --- OpenAI-compatible endpoint (covers OpenAI, NVIDIA NIM, vLLM, ...) ---
# Hosted NVIDIA NIM:  OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Self-hosted NIM:     OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Which drafting backend: auto (first configured provider), openai,
# anthropic, ollama, or offline.
# LLM_BACKEND=auto

# --- Stores: switching is an env change only ---
# Local default (zero setup): with DATABASE_URL unset, records,
# checkpoints and policy embeddings persist to a single SQLite file.
# SQLITE_PATH=data/cx.db
#
# Production (docker compose sets these): set DATABASE_URL and the
# same code runs on PostgreSQL + pgvector instead.
# DATABASE_URL=postgresql://cxagent:cxagent@localhost:5432/cxagent
# S3_BUCKET=conversation-documents
# S3_ENDPOINT_URL=http://minio:8333
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1

# --- Policy thresholds (defaults shown; see cx_agent/policy.py) ---
# CX_GOODWILL_CREDIT_CAP=25.00    goodwill credit the agent may propose
#                                 on its own authority, in dollars
# CX_DISPUTE_CREDIT_CAP=50.00     evidenced-dispute credit cap; above
#                                 this the case escalates to billing
# CX_ROAMING_FAIR_USE_GB=25       roaming fair-use ceiling per trip
# CX_MAX_NO_PROGRESS_TURNS=3      unproductive turns before escalation
# CX_OTP_MAX_ATTEMPTS=3           verification attempts before lockout
# CX_ANNOTATION_SAMPLE_MODULUS=5  annotation queue: one in this many
#                                 resolved conversations is sampled
#                                 for review (1 = all of them)

# Optional shared secret for the API (unset = open, local demos only).
# API_KEY=
